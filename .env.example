# ============================================================
# Digi Vidyarthi — Environment Configuration (EXAMPLE)
# ============================================================
# Copy this file to ".env" and fill in real values.
# IMPORTANT: ".env" is in .gitignore. NEVER commit it.
# ============================================================

# --- Admin password (used by admin.php) ---
ADMIN_PASSWORD=

# --- MySQL Database Credentials ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# --- CORS — only your own domain ---
ALLOWED_ORIGIN=https://digividyarthi.com